# NutriSnap AI Backend Environment Configuration

# Server Port
PORT=3000

# Google Gemini API Key (Needed for AI food recognition and chatbot)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# USDA FoodData Central API Key (Needed for nutrition calculations)
# Free registration at: https://fdc.nal.usda.gov/api-key-signup.html
# Use DEMO_KEY for initial testing
USDA_API_KEY=DEMO_KEY

# Node Environment
NODE_ENV=development
